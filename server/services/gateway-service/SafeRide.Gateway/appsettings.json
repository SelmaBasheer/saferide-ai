{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "saferide-ai",
    "Audience": "saferide-ai-clients"
  },
  "KeyVault": {
    "Uri": "https://saferide-kv-selma.vault.azure.net/"
  },

  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Order": 100,
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "schools": {
        "ClusterId": "school",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/schools/{**catch-all}" }
      },
      "drivers": {
        "ClusterId": "driver",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/drivers/{**catch-all}" }
      },
      "students": {
        "ClusterId": "student",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/students/{**catch-all}" }
      },
      "buses": {
        "ClusterId": "bus",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/buses/{**catch-all}" }
      },
      "routes": {
        "ClusterId": "route",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/routes/{**catch-all}" }
      },
      "trips": {
        "ClusterId": "tracking",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/trips/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "tracking",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },

    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "school": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "driver": { "Destinations": { "d1": { "Address": "http://localhost:5007/" } } },
      "student": { "Destinations": { "d1": { "Address": "http://localhost:5009/" } } },
      "bus": { "Destinations": { "d1": { "Address": "http://localhost:5011/" } } },
      "route": { "Destinations": { "d1": { "Address": "http://localhost:5013/" } } },
      "tracking": { "Destinations": { "d1": { "Address": "http://localhost:5015/" } } }
    }
  }
}
